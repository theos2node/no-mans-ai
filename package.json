{
  "name": "no-mans-ai",
  "version": "0.1.0",
  "description": "Observable laboratory for LLM-directed office simulations",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theos2node/no-mans-ai.git"
  },
  "bugs": {
    "url": "https://github.com/theos2node/no-mans-ai/issues"
  },
  "homepage": "https://github.com/theos2node/no-mans-ai#readme",
  "keywords": [
    "agent-simulation",
    "deterministic-replay",
    "llm",
    "multi-agent",
    "ollama",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "scripts": {
    "api": "node src/api/server.ts",
    "dev": "vite",
    "build": "vite build",
    "build:sprites": "node scripts/build-sprites.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "scenario": "node scripts/run-scenario.ts",
    "ci": "npm run check && npm test && npm run build && npm run scenario -- refund-approval --json",
    "preview": "vite preview",
    "proxy": "./scripts/run-local-openai-proxy.sh"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
