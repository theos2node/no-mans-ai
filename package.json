{
  "name": "no-mans-ai",
  "version": "0.1.0",
  "description": "Two-character Smallville-style prototype powered by GPT-5 Nano",
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "check": "tsc --noEmit",
    "start": "tsx server/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "type": "module",
